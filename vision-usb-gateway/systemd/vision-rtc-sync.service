[Unit]
Description=System Clock to RTC
After=local-fs.target
# No ConditionPathExists=/dev/rtc0: this also saves the clock to the NVMe
# (persist_save) every 10 min, which a unit without an RTC needs most; with
# no RTC the hwclock step is skipped by the script itself.

[Service]
Type=oneshot
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/rtc-sync.sh --systohc
