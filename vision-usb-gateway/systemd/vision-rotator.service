[Unit]
Description=Vision Rotator
After=vision-monitor.service

# A late mirror mount (long fsck after a power cut) must not let this run
# against the bare mountpoint on the root filesystem.
RequiresMountsFor=/srv/vision_mirror

[Service]
Type=oneshot
TimeoutStartSec=10min
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/vision-rotator.sh
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/run /sys/kernel/config /srv/vision_mirror /mnt
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
