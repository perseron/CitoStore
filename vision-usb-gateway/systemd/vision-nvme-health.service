[Unit]
Description=Vision NVMe SMART Cache
After=local-fs.target

# Ordered after the mirror mount (not Required: it must still report when the
# mirror is missing).
After=srv-vision_mirror.mount

[Service]
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
Type=oneshot
TimeoutStartSec=2min
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/nvme-health.sh
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/run /srv/vision_mirror/.state

[Install]
WantedBy=multi-user.target
