[Unit]
Description=Offline Maintenance for %i
After=local-fs.target
# Never without the mirror: the export would go into the bare mount point (the
# RAM root) and the drive then be formatted — its images gone at the next boot.
RequiresMountsFor=/srv/vision_mirror

[Service]
Type=oneshot
TimeoutStartSec=30min
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/offline-maint.sh %i
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/srv/vision_mirror /run /mnt
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
