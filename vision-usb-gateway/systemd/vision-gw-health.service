[Unit]
Description=Vision Gateway Health Check
# The mirror mounts with nofail, so local-fs.target does NOT wait for it —
# ordering on the mount unit itself is what actually serialises us behind
# the LVM activation (seen failing at cold boot: "mirror not mounted").
# Wants (not Requires): if the mirror really is gone, the health check must
# still run and say so.
After=local-fs.target srv-vision_mirror.mount
Wants=srv-vision_mirror.mount
Before=vision-gw-config.service usb-gadget.service vision-sync.service vision-monitor.service vision-rotator.service vision-webui.service

[Service]
# Bounded: everything that matters is ordered after it, and an LVM/fsck call
# hung on a failing NVMe would otherwise hold the whole boot forever.
TimeoutStartSec=5min
Type=oneshot
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/health-check.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
