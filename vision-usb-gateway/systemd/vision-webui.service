[Unit]
Description=Vision Web UI
After=network-online.target vision-gw-config.service
Wants=network-online.target
# Wants, not Requires: when vision-gw-config fails (e.g. the NVMe is not
# mounted) the WebUI is exactly what is needed to see why.
Wants=vision-gw-config.service

[Service]
Type=notify
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/usr/bin/python3 -m vision_webui.server
Restart=on-failure
RestartSec=5
WatchdogSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# '-': a missing path (no NVMe mounted) must not fail the namespace setup.
ReadWritePaths=-/srv/vision_mirror/.state /etc/vision-gw.conf /etc/vision-gw.env /etc/systemd/system /etc/samba -/etc/vision-nas.creds /run /var/log
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
