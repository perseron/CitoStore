[Unit]
Description=Apply Network Settings from Shadow
After=NetworkManager.service
Wants=NetworkManager.service
# network.json lives on the NVMe mirror. The mount is nofail (so not ordered
# before local-fs.target) and landed ~1s after this ran: the file was "not
# found", the static IP silently fell back to DHCP on every reboot.
RequiresMountsFor=/srv/vision_mirror
Before=network-online.target

[Service]
Type=oneshot
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/apply-network.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
