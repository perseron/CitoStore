[Unit]
Description=Bind Samba state onto NVMe (overlay-safe persistence)
Documentation=man:smbd(8)
# Samba's writable databases (passdb.tdb = SMB users/passwords, secrets.tdb)
# live under /var/lib/samba, which is on the read-only root under the overlay.
# Bind it to the NVMe mirror so SMB passwords survive reboots.
#
# DefaultDependencies=no keeps this OUT of local-fs.target: the default
# Before=local-fs.target a mount unit gets, combined with our
# After=vision-factory-reset-boot.service (whose own default dependencies pull
# sysinit/basic), closed an ordering CYCLE through sysinit.target — and systemd
# breaks cycles by DELETING boot jobs by lottery. Observed casualties on a real
# boot: systemd-timesyncd (unit boots with a dead clock — no NTP ever),
# systemd-tmpfiles-setup, systemd-update-utmp and systemd-binfmt. Nothing needs
# this bind in local-fs.target; smbd/nmbd order on it explicitly below (plus
# RequiresMountsFor=/var/lib/samba in smbd's drop-in).
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
Requires=srv-vision_mirror.mount
After=srv-vision_mirror.mount vision-factory-reset-boot.service
Before=smbd.service nmbd.service
ConditionPathIsDirectory=/srv/vision_mirror/.state/samba

[Mount]
What=/srv/vision_mirror/.state/samba
Where=/var/lib/samba
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
