[Unit]
Description=NAS Sync
# The share is automounted on first access (60_configure_nas_optional.sh).
After=local-fs.target network-online.target

# A late mirror mount (long fsck after a power cut) must not let this run
# against the bare mountpoint on the root filesystem.
RequiresMountsFor=/srv/vision_mirror

[Service]
Type=oneshot
TimeoutStartSec=6h
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/nas-sync.sh
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/srv/vision_mirror /run /mnt
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
