[Unit]
Description=Mirror Retention
After=local-fs.target

# A late mirror mount (long fsck after a power cut) must not let this run
# against the bare mountpoint on the root filesystem.
RequiresMountsFor=/srv/vision_mirror

[Service]
Type=oneshot
TimeoutStartSec=30min
Environment=GATEWAY_HOME=/opt/CitoStore/vision-usb-gateway
EnvironmentFile=-/etc/vision-gw.env
ExecStart=/bin/bash ${GATEWAY_HOME}/scripts/mirror-retention.sh
ProtectSystem=strict
PrivateTmp=true
# A walk of every image on the mirror: behind the sync and the AOI.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ReadWritePaths=/srv/vision_mirror /run
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
